# ================================================
# .env - Variables d'environnement UNIFIÉES
# ================================================

# ============ DOCKER & PROJET ============
COMPOSE_PROJECT_NAME=cloudweb
DEPLOYMENT_MODE=docker
API_VERSION=v1
DEBUG_MODE=false

# ============ PORTS ============
SERVER_PORT=8083               # Backend Spring Boot
FRONTEND_PORT=5173             # Frontend React
DB_HOST_PORT=5433              # PostgreSQL exposé sur l'hôte
DB_CONTAINER_PORT=5432         # PostgreSQL interne au conteneur

# ============ BASE DE DONNÉES ============
DB_NAME=authdb
DB_USERNAME=postgres
DB_PASSWORD=StrongPassword123!
DB_SCHEMA=public

# ============ BACKEND SPRING BOOT ============
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-123!
JWT_EXPIRATION_MS=86400000  # 24 heures
JWT_ISSUER=cloudweb-api

# Sécurité
LOGIN_ATTEMPTS_LIMIT=3
ACCOUNT_LOCK_DURATION_MINUTES=30
BCRYPT_STRENGTH=12

# ============ FIREBASE BACKEND ============
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=cloud-web-mobile
FIREBASE_PRIVATE_KEY_ID=RSQwZeB9nxeogGfXcJDp5rkyZKo2
# ⚠️ REMPLACEZ par votre VRAIE clé privée complète (voir ci-dessous)
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQDLU+... (votre clé complète)\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@cloud-web-mobile.iam.gserviceaccount.com  # ⬅️ CORRIGÉ
FIREBASE_CLIENT_ID=259432446366  # ⬅️ CORRIGÉ (messagingSenderId)
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40cloud-web-mobile.iam.gserviceaccount.com

# ============ FIREBASE FRONTEND ============
# Ces variables sont pour React (préfixe VITE_)
VITE_FIREBASE_API_KEY=AIzaSyCykKeXJlzssjXyCqEWsSHZ_T6ljabYTbM
VITE_FIREBASE_AUTH_DOMAIN=cloud-web-mobile.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cloud-web-mobile
