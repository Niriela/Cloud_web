# ============ FRONTEND REACT ============
REACT_APP_API_URL=http://localhost:8083/api      # Pour développement local
REACT_APP_API_URL_DOCKER=http://backend:8083/api # Pour Docker à Docker
REACT_APP_NAME=CloudWeb
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=production

# URLs de l'application
FRONTEND_URL=http://localhost:${FRONTEND_PORT}
BACKEND_URL=http://localhost:${SERVER_PORT}
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://localhost:5173,http://localhost:8083

# ============ MOBILE ============
MOBILE_API_URL=http://localhost:${SERVER_PORT}/api

# ============ CARTE OFFLINE ============
TILESERVER_PORT=8085
TILESERVER_THREADS=2
VITE_TILESERVER_URL=http://localhost:8085
VITE_TILESERVER_DOCKER_URL=http://tileserver