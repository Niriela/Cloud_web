# ================================================
# .env - Variables d'environnement UNIFIÉES
# ================================================

# ============ DOCKER & PROJET ============
COMPOSE_PROJECT_NAME=cloudweb
DEPLOYMENT_MODE=docker
API_VERSION=v1
DEBUG_MODE=false

# ============ PORTS ============
SERVER_PORT=8080               # Backend Spring Boot
FRONTEND_PORT=5173             # Frontend React
DB_HOST_PORT=5433              # PostgreSQL exposé sur l'hôte
DB_CONTAINER_PORT=5432         # PostgreSQL interne au conteneur

# ============ BASE DE DONNÉES ============
DB_NAME=authdb
DB_USERNAME=postgres
DB_PASSWORD=StrongPassword123!
DB_SCHEMA=public

# ============ BACKEND SPRING BOOT ============
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-123!
JWT_EXPIRATION_MS=86400000  # 24 heures
JWT_ISSUER=cloudweb-api

# Sécurité
LOGIN_ATTEMPTS_LIMIT=3
ACCOUNT_LOCK_DURATION_MINUTES=30
BCRYPT_STRENGTH=12

# ============ FIREBASE ============
FIREBASE_ENABLED=false  # Mettre à true si vous utilisez Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789012345678901
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# ============ FRONTEND REACT ============
REACT_APP_API_URL=http://localhost:8080/api      # Pour développement local
REACT_APP_API_URL_DOCKER=http://backend:8080/api # Pour Docker à Docker
REACT_APP_NAME=CloudWeb
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=production

# URLs de l'application
FRONTEND_URL=http://localhost:${FRONTEND_PORT}
BACKEND_URL=http://localhost:${SERVER_PORT}
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://localhost:5173,http://localhost:8080

# ============ MOBILE ============
MOBILE_API_URL=http://localhost:${SERVER_PORT}/api