# .env.example
# Copier ce fichier en .env et remplir les valeurs

# Configuration de la base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cloud_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST_PORT=5433

# Configuration JWT
JWT_SECRET=your_secret_key_change_this_in_production_with_a_long_random_string_at_least_256_bits
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=

# Configuration Firebase (optionnel)
FIREBASE_ENABLED=true
# Chemin du JSON DANS le conteneur backend (fichier monte via ./secrets)
# Exemple: placer votre JSON dans ./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT=/app/secrets/cloud-web-mobile-firebase-adminsdk-fbsvc-3dbea73f57.json
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# Bootstrap des donnees au demarrage backend Docker:
# - seed: insertions initiales idempotentes (recommande pour dev)
# - none: aucun bootstrap data
APP_BOOTSTRAP_MODE=seed
APP_BOOTSTRAP_SEED_DEFAULT_MANAGER=true
APP_BOOTSTRAP_MANAGER_EMAIL=manager@example.com
APP_BOOTSTRAP_MANAGER_PASSWORD=123456
APP_BOOTSTRAP_MANAGER_FIRST_NAME=Manager
APP_BOOTSTRAP_MANAGER_LAST_NAME=Admin

# Configuration du serveur backend
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# Configuration du frontend
FRONTEND_PORT=5173
REACT_APP_NAME=CloudWeb
VITE_API_BASE=http://localhost:8080
VITE_API_URL=http://localhost:8080

# Configuration OSM Server
OSM_PORT=8090
